for (si in 1:length(sds_inv)){
for (se in 1:length(sds_err)){
for (a in 1:length(arms)){
rs[r1, 1:(5+arms[a])] <- c(seeds[s], trials[t],  arms[a], sds_inv[si], sds_err[se], m_0[1:arms[a]])
r1 <- r1+1
}
}
}
}
}
