est <- find_the_best_pars(c(0.0001,0.0001,0.0001,0.0001), c(10, 1, 1,10), sym_auto_negLogLik_DE, dat, nm, nt)
par <- est$parameter
mat_value[t, 4, s] <- as.vector(unlist(est$value))
