arm_mean[t+1,] <- arm_mean[t, ] + kalman_t
arm_variance[t+1, ] <- (1-kalman_t)*(arm_variance[t, ]+innovation_term)
}
return(list(arm_mean = arm_mean, arm_variance = arm_variance,
