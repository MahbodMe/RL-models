### takes a list of function and parameters and data, produces para_est
find_the_best_pars <- function(lpar, upar, fun, df, nm, nt){
value <- rep("NA", nm)
parameter <- rep(0, nm)
for (i in 1:nm){
x <- (i-1)*nt + 1
y <- i*nt
est_DE <- DEoptim(fun,lower=as.double(lpar),
upper=as.double(upar),data=df[x:y,],
control=DEoptim.control(trace=FALSE))
value[i] <- list(est_DE$optim$bestval)
parameter[i] <- list(est_DE$optim$bestmem)
}
return(list(parameter = parameter, value = value))
}
df <- read.csv("https://github.com/speekenbrink-lab/data/raw/master/Speekenbrink_Konstantinidis_2015.csv")
np <- length(unique(df$id2))
seeds <- sample(1:1000, 5)
mat_n <- matrix(data = 0, nrow = np, ncol = 1)
mat_value <- array(data = NA, c(np, 12, length(seeds)))
mat_par <- array(NA, c(12, 8, np, length(seeds)))
n <- 1
arm <<- 4
nm <- 1
innovation_term <<- 16
for (s in 1:length(seeds)){
set.seed(seeds[s])
for (t in 1:np){
dat <- df %>%
filter(id2==t)
nt <- length(dat$deck)
mat_n[t, 1] <- nt
print(t)
# model 1
est <- find_the_best_pars(c(.0001, .0001), c(100, 1), sym_negLogLik_DE, dat, nm, nt)
par <- est$parameter
mat_value[t, 1, s] <- as.vector(unlist(est$value))
mat_par[1,1:length(as.vector(unlist(par))),t,s] <- as.vector(unlist(par[1:length(as.vector(unlist(par)))]))
# model 2
est <- find_the_best_pars(c(0.0001,0.0001,0.0001), c(10, 1, 1), asym_rpe_negLogLik_DE, dat, nm, nt)
par <- est$parameter
mat_value[t, 2, s] <- as.vector(unlist(est$value))
mat_par[2,1:length(as.vector(unlist(par))),t,s] <- as.vector(unlist(par[1:length(as.vector(unlist(par)))]))
# model 3
