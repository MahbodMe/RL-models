m[t+1,] <- m[t,] + kt*(reward[t] - m[t,])
v[t+1,] <- (1-kt)*(v[t,] + sigma_xi_sq)
}
return(list(m=m,v=v,choices=choice, agents_rewards=reward, total_rewards = sum(reward)))
}
