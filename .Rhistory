library(nnet)
rl_ucb_sim <- function(rewards, intial_mean, intial_variance, innovation_term,
error_term, beta) {
n_trials <- nrow(rewards) # Number of Trials
n_options <- ncol(rewards) # Number of Options
choices <- rep(0, n_trials + 1) # All the choices over the trials
rewards <- rep(0, n_trials + 1) # All the rewards over the trials
agents_rewards <- 0
arm_mean <- matrix(intial_mean, ncol = n_options-1, nrow = n_trials + 1)
arm_variance <- matrix(intial_variance, ncol = n_options-1,
nrow = n_trials + 1)
ucb_values <- rep(0,4)
for (t in 1:n_trials) {
for (a in 1: n_options){
ucb_values[a] <-  arm_mean[t,a]/sum(arm_mean[t,])
}
choices[t] <- which.is.max(ucb_value)
reward  <- choice[t]
agents_total_rewards <- agents_total_rewards + reward
agents_rewards[t] <- reward
for (a in 1:n_options){
if (a == choices[t]){
kalman_t[a] <- (arm_variance[a] + innovation_term) /
(arm_variance[a] + innovation_term + error_term)
} else {
kalman_t[a] <- 0
}
}
if (t<201){
arm_mean[t+1,] <- arm_mean[t, ] + kalman_t
arm_variance[t+1, ] <- (1-kalman_t)*(arm_variance[t, ]+innovation_term)
}
}
return(list(arm_mean = arm_mean, arm_variance = arm_variance,
choices = choices, agents_rewards = agents_rewards,
agents_total_rewards = agents_total_rewards))
}
