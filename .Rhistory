m_bic[id, ]<- ngll[id, ]*2 + log(200)*par_num
aic_mins[which.min(m_aic[id, ])] <- aic_mins[which.min(m_aic[id, ])] + 1
bic_mins[which.min(m_bic[id, ])] <- bic_mins[which.min(m_bic[id, ])] + 1
}
MS_2_mod_mins <- cbind(aic_mins, bic_mins)
