### Confirmatory Analysis

## First Analysis
# Does instructing participants to “think slow” increase or decrease their overall performance in the judgment tasks 
# (compared to no instruction)? 

# I want to keep the procedure as simple as possible. 
# There are two independent groups of the same size, with the same dependent variable. 
# Thus, a single independent samples t-test is enough to distinguish between these two sample groups. 



df_slow <- df %>% #experimental group
  filter(condition=="slow")
df_control <- df %>% #control group
  filter(condition=="control")
df_slow_control <- df %>% #experimental and control group
  filter(condition=="control" | condition=="slow")
           
#visualizing the two groups
plot_raincloud(df_slow_control, performance, groups = condition) + 
  labs(title = "No instruction vs. Thinking Slow", y="Scores of the judement tasks", x="Conditions")

# Assumptions:
# Assumption 1: Are the two samples independents?
# Yes, the samples are not related, the samples were randomly selected and assigned.
# Assumption 2: Are the data from each of the 2 groups follow a normal distribution?
# As a rule of thumb, if skewness is between -.5 and .5 the distribution is fairly symmetrical, 
# between -1 and – 0.5 or between 0.5 and 1, the distribution is moderately skewed, 
# and anything more extreme is highly skewed. 

e1071::skewness(df_slow$performance) #results: -.350
e1071::skewness(df_control$performance) #results: .010

# This assumption of normality is granted as both groups are fairly symmetrical. 
# Assumption 3: Do the two populations have the same variances?

test_var <- var.test(performance ~ condition, data = df_slow_control)
test_var #p = .760

# The p-value is much higher than .05, 
# which indicates the difference in variance between the two groups is not significant.

# We have met all the assumptions and now can proceed to our analysis.

t.test(df_slow$performance, df_control$performance, alternative = "two.sided", var.equal = TRUE)
#results were not significant p = .656

#More information to report the results
summary(df_slow$performance) 
sample_sd(df_slow$performance) #2.935
nrow(df_slow) #number of participants in the expriment group, 200
summary(df_control$performance)
sample_sd(df_control$performance) #2.872
nrow(df_control) #number of participants in the control group, 200
df_slow_control$condition <- as.factor(df_slow_control$condition)
contrasts(df_slow_control$condition) <- cbind(c1 = c(-1/2, 1/2))
psych::cohen.d(df_slow_control$performance, df_slow_control$condition) # effect size = .04

