### Post Hoc analysis
## Forth Analysis
# Is average response time on the judgment task mediated by access to rule application? 
# That is participants who have access to these rules (i.e. higher score on this measure) take less time 
# to complete the judgment task.
# I will conduct a mediation analysis to figure this out
# The main assumption for mediation analysis is normality

e1071::skewness(df$ave_rt) # ave_rt is highly and positively skewed  
e1071::skewness(df$performance) #Fairly normal
e1071::skewness(df$rules) #Negatively Skewed

# To adjust I will take log(10) of each score on this measure
df2 <- df %>%
  mutate(ave_rt = log(ave_rt, 10), rules = rules**2)

df2 %>%
  filter(condition != "fast") %>%
  ggpairs(df2[,c("rules", "performance", "ave_rt")], 
        upper= list(continuous = wrap(ggally_cor, family="sans"))) + labs(title="Exploratory Data Analysis")

ggpairs(df2[,c("rules", "performance", "ave_rt")], 
        upper= list(continuous = wrap(ggally_cor, family="sans"))) + labs(title="Exploratory Data Analysis")

e1071::skewness(df2$ave_rt) # Now the measure is fairly symmetrical (-0.03)
e1071::skewness(df2$rules)  # Now fairly symmetrical -.54


# Causal steps

mod1 <- lm(performance ~ ave_rt, df2)
summary(mod1)
# Step one satisfied
mod2 <- lm(rules ~ ave_rt, df2)
summary(mod2)
# Step two satisfied 
mod3 <- lm(performance ~ ave_rt + rules, df2)
summary(mod3)

# Step three satisfied 
# The model is full mediation

set.seed(20210118)
med <- mediation::mediate(model.m = mod2, model.y = mod3, sims = 2000, boot = TRUE, boot.ci.type = "bca", treat = "ave_rt", mediator = "rules")
summary(med)

# ACME is significant, ADE is as well, total effect and prop. Mediated are as well
# The assumptions are satisfied and the non-parametric analysis confirms the analysis

# Repeating the analysis without the fast condition
df3 <- df2 %>%
  filter(condition != "fast")

mod1 <- lm(performance ~ ave_rt, df3)
summary(mod1)
# Step one satisfied
mod2 <- lm(rules ~ ave_rt, df3)
summary(mod2)
# Step two satisfied 
mod3 <- lm(performance ~ ave_rt + rules, df3)
summary(mod3)
# Step three satisfied 
# The model is still apartial medaition mediation

set.seed(20210118)
med <- mediation::mediate(model.m = mod2, model.y = mod3, sims = 2000, boot = TRUE, boot.ci.type = "bca", treat = "ave_rt", mediator = "rules")
summary(med)


# Non-parametric analysis confirms the results



