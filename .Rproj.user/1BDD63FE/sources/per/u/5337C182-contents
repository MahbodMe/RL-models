mod_MC <- function(X){

  print(X)
  

  est <- c(1:12)
  est <- est*(10^X)

  mat_value[1] <- as.vector(unlist(est[1]))

  mat_value[2] <- as.vector(unlist(est[2]))

  mat_value[3]<- as.vector(unlist(est[3]))

  
  # model 4

  mat_value[4] <- as.vector(unlist(est[4]))

  
  
  # model 5
  mat_value[5] <- as.vector(unlist(est[5]))

  
  
  # model 6
  mat_value[6] <- as.vector(unlist(est[6]))

  
  # model 7
  mat_value[7] <- as.vector(unlist(est[7]))

  # model 8
  mat_value[8] <- as.vector(unlist(est[8]))

  # model 9
  mat_value[9] <- as.vector(unlist(est[9]))

  
  # model 10
  mat_value[10]<- as.vector(unlist(est[10]))

  
  # model 11
  mat_value[11] <- as.vector(unlist(est[11]))

  # model 12
  mat_value[12] <- as.vector(unlist(est[12]))

